# FinPilot backend. Copy to backend/.env. Never commit the real file.

# --- Supabase database (Project Settings > Database > Database password; reset it there if forgotten) ---
SUPABASE_DB_PASSWORD=
# Only needed if the direct host is unreachable on your network (IPv4-only). e.g. ap-south-1
SUPABASE_REGION=
# Optional full override instead of the three values above:
# DATABASE_URL=postgresql://...

# --- Supabase Auth (Project Settings > API) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Only for legacy projects that sign JWTs with a shared HS256 secret. Leave empty when the project
# uses asymmetric JWT signing keys (the backend then verifies tokens through the project's JWKS).
SUPABASE_JWT_SECRET=

CORS_ORIGINS=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata
DEMO_MODE=true
# Balance (INR) you do not want upcoming payments to push you below
SAFETY_BUFFER=5000

# --- AI agent (LangGraph + configurable LLM provider) ---
LLM_PROVIDER=gemini            # gemini | openai | anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# OPENAI_API_KEY=              # pip install langchain-openai
# ANTHROPIC_API_KEY=           # pip install langchain-anthropic
# LLM_MODEL=                   # optional override for any provider

# --- Account Aggregator sandbox (Setu). Leave blank: the adapter stays inactive. ---
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=
SETU_BASE_URL=https://fiu-sandbox.setu.co
